@model IEnumerable<RaceDay.MVC.Models.EventDto>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Organiser Dashboard</h1>
        <a asp-action="Create" class="btn btn-primary">+ Create New Event</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">You haven't created any events yet.</div>
    }
    else
    {
        <div class="row">
            @foreach (var ev in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100">
                        @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                        {
                            <img src="@ev.BannerImageUrl" class="card-img-top" alt="@ev.Name" style="height: 180px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-secondary text-white text-center py-5" style="height: 180px;">No Image</div>
                        }
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@ev.Name</h5>
                            <p class="card-text text-muted mb-1">📍 @ev.Location</p>
                            <p class="card-text mb-1">📅 @ev.EventDate.ToString("dd MMM yyyy")</p>
                            <span class="badge @(ev.Status == "Open" ? "bg-success" : "bg-warning text-dark")">@ev.Status</span>
                        </div>
                        <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                            <a href="#" class="btn btn-sm btn-outline-primary">Manage Enrolments</a>
                            <a href="#" class="btn btn-sm btn-outline-secondary">Results</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>