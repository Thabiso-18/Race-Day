
name: Race-Day Code Quality

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  quality-check:
    name: Check C# Code Quality
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up .NET SDK
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: 8.0.x

      - name: Locate solution or project
        shell: bash
        run: |
          PROJECT=$(find . \
            \( -name '*.sln' -o -name '*.slnx' \) \
            -not -path '*/bin/*' \
            -not -path '*/obj/*' | head -n 1)

          if [ -z "$PROJECT" ]; then
            PROJECT=$(find . -name '*.csproj' \
              -not -path '*/bin/*' \
              -not -path '*/obj/*' | head -n 1)
          fi

          if [ -z "$PROJECT" ]; then
            echo "::error::No .NET solution or project found."
            exit 1
          fi

          echo "PROJECT=$PROJECT" >> "$GITHUB_ENV"
          echo "Checking: $PROJECT"

      - name: Restore dependencies
        run: dotnet restore "$PROJECT"

      - name: Check C# formatting
        run: dotnet format "$PROJECT" --verify-no-changes --no-restore

      - name: Build in Release mode
        run: dotnet build "$PROJECT" --configuration Release --no-restore

      - name: Report success
        if: success()
        run: echo "Code quality checks passed!"
